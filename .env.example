# ============================================================================
# MyISKCON Accounts — environment variables
# Copy this file to ".env" (local) or set these in the Vercel dashboard
# (Project → Settings → Environment Variables). NEVER commit the real .env.
# ============================================================================

# --- Database (Neon Postgres, via Vercel Marketplace integration) ---
# Vercel auto-injects DATABASE_URL when you link a Neon database to your project.
# For local dev, copy from the Vercel dashboard (Storage → your Neon db → Connect).
# Pooled connection (HTTP fetch via Neon serverless driver) — used by our db client.
DATABASE_URL=
# Optional: direct (non-pooled) connection for migrations / scripts.
DATABASE_URL_DIRECT=

# --- App ---
# Random 64+ char string used to sign/verify session IDs (HMAC). Generate with:
#   openssl rand -hex 48
SESSION_SECRET=

# Random 32+ char string used for legacy SHA-256 password verification.
# MUST match the old PASSWORD_SALT from Code.gs so migrated users can log in.
# After all users have been rehashed to bcrypt, this can be removed.
LEGACY_PASSWORD_SALT=

# Random 32-byte (64 hex char) key for AES-256-GCM encryption of PAN/email at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY_HEX=

# The OLD ENCRYPTION_KEY from Code.gs, used ONLY to decrypt migrated PAN/email
# records that were XOR+base64 encrypted by the legacy backend. After all rows
# are re-encrypted with AES-256-GCM, this can be removed.
LEGACY_ENCRYPTION_KEY=

# --- Auth ---
SESSION_TIMEOUT_HOURS=24

# Default superadmin username (created on first run of `npm run db:push`)
SUPERADMIN_USERNAME=Sivatma Govinda Dasa
# Developer override username (above superadmin)
DEVELOPER_USERNAME=Visnu Jagatpalaka Dasa

# --- Razorpay (server-side only — NEVER expose Key Secret to the client) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- WhatsApp (bhashsms) ---
BHASHSMS_USER=
BHASHSMS_PASSWORD=
BHASHSMS_SENDER_ID=
BHASHSMS_TEMPLATE=

# --- Vercel Cron ---
# Bearer token that the cron job must send to authorize cleanup calls.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Audit log ---
AUDIT_LOG_ENABLED=false
